# ── Required ──────────────────────────────────────────────────────────────
# Claude powers ideas, scripts, and SEO metadata.
ANTHROPIC_API_KEY=

# Model + effort (optional overrides; sensible defaults baked in).
# PBM_MODEL=claude-opus-4-8
# PBM_EFFORT=high            # low | medium | high | xhigh | max

# ── Voiceover (optional) ──────────────────────────────────────────────────
# TTS_PROVIDER selects the narration engine. "none" => write narration text
# only (dry run). Anything else requires the matching key below.
TTS_PROVIDER=none            # none | elevenlabs | openai

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=         # e.g. a calm narrator voice id
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

OPENAI_API_KEY=
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=onyx

# ── Visuals (optional) ────────────────────────────────────────────────────
# Free stock B-roll from Pexels. Without it, a storyboard is written instead.
PEXELS_API_KEY=

# ── Upload (optional) ─────────────────────────────────────────────────────
# YouTube Data API v3 OAuth2. Without these, upload runs in dry-run mode.
# Create an OAuth client (Desktop) in Google Cloud, then obtain a refresh
# token with the youtube.upload scope.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Default privacy for manual uploads: private | unlisted | public
YOUTUBE_PRIVACY=private

# ── Autopilot (fully hands-off) ───────────────────────────────────────────
# How `npm run autopilot` publishes:
#   scheduled — upload private + auto-publish at the scheduled time (default)
#   review    — upload private; a human publishes (safest)
#   public    — publish public immediately (highest policy risk)
PBM_PUBLISH_MODE=scheduled
# UTC offset for calendar slot times, e.g. -05:00 (US Eastern), +00:00 (UTC).
YOUTUBE_PUBLISH_TZ_OFFSET=+00:00
# Lead time (hours) for the auto-publish time when no future slot time applies.
PBM_PUBLISH_DELAY_HOURS=3
